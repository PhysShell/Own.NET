module WpfTimerStopDisposingElseBranch

// A running timer: `Elapsed += handler` + `Start()` acquires the timer<->owner
// edge; the matching `Stop()` releases it. `kind` tags the resource so the
// generic ownership finding carries a [resource: timer] note.
resource Timer {
    acquire Start
    release Stop
    kind "timer"
}

// Dispose(bool disposing) with the Stop() in the ELSE branch: on the managed
// path (disposing=true — the only path that runs while the owner is reachable)
// the timer is never stopped => OWN001.
fn DisposeBool(interval: int, disposing: int) {
    let t = acquire Timer(interval);
    if (disposing) {
        return;                 // managed-dispose path exits WITHOUT stopping
    }
    release t;                  // finalizer-only branch: unreachable while running
}

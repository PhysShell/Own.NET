module WpfTimerStopEarlyReturnGuard

// A running timer: `Elapsed += handler` + `Start()` acquires the timer<->owner
// edge; the matching `Stop()` releases it. `kind` tags the resource so the
// generic ownership finding carries a [resource: timer] note.
resource Timer {
    acquire Start
    release Stop
    kind "timer"
}

// The Stop() sits after `if (keepTicking) return;` inside a teardown-called
// helper — the early-return spelling of the caller-controlled guard. On the
// production path (keepTicking=true) the timer is never stopped => OWN001.
fn ShutdownKeepTicking(interval: int, keepTicking: int) {
    let t = acquire Timer(interval);
    if (keepTicking) {
        return;                 // production callers pass true
    }
    release t;                  // the early-return-guarded Stop()
}

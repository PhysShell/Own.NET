<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>ownsharp</AssemblyName>

    <!-- Alpha gate A (issue #202): the single delightful command. Packaging
         only, no analysis logic here — this tool wraps the two existing
         pieces (extractor -> core) the same way scripts/own-check.sh already
         does, so they ship as ONE `dotnet tool install`.

         Public facade (docs/notes/owen-public-facade.md): the PROJECT stays
         "OwnSharp.Cli" internally (not mass-renamed — that would be an
         internal refactor, not what this is), but the PUBLISHED package ID,
         command name, and all user-facing output are "Owen"/"owen". Product
         "Owen" is language-neutral at the OwnIR/core level; this NuGet
         package is specifically the .NET/C# frontend distribution of it —
         see Program.cs's help text for the exact honest framing.

         Packaging shape (design decision recorded in issue #202):
         - The Roslyn extractor (OwnSharp.Extractor, unmodified, P-013) is
           pulled in via ProjectReference below; its build output (dll +
           .deps.json/.runtimeconfig.json + Roslyn deps) rides along in this
           tool's own pack payload because PackAsTool packs this project's
           full publish closure. At runtime `check` invokes it as a child
           process ("dotnet exec (bundled)/ownsharp-extract.dll ..."),
           the same subprocess shape own-check.sh already uses, just against
           a bundled binary instead of running the extractor from source.
         - The Python core (ownlang/, zero-dependency pure Python, see
           ../../../pyproject.toml) is vendored as loose *.py content below
           and unpacked to ~/.owen/core/<version>/ on first run (falling back
           to a previous ~/.ownsharp/core/<version>/ if already unpacked
           there — see CoreVendor.cs); it is executed by the machine's own
           Python (>=3.11), never embedded or compiled. See Program.cs for
           the resolution/unpack/fail-fast logic and the rejected
           alternatives on record in issue #202.
    -->
    <PackAsTool>true</PackAsTool>
    <!-- User-facing command: "owen". AssemblyName above stays "ownsharp";
         it names the internal .dll the shim launches, never typed or seen by
         a user, so changing it would add no user value (the "may remain
         internal" case). -->
    <ToolCommandName>owen</ToolCommandName>
    <PackageId>Owen.Cli</PackageId>
    <!-- Versioning policy (docs/notes/owen-cli-release.md): this Version is
         the single source of truth. A publish only runs off a git tag
         `owen-cli-vMAJOR.MINOR.PATCH` whose suffix matches this value
         byte-for-byte — the release workflow asserts that and fails loudly on
         drift instead of guessing which one is right. Bump here first, then tag. -->
    <Version>0.1.0</Version>
    <Description>Owen finds lifetime and resource-contract bugs. This distribution currently includes the .NET/C# frontend: `owen check &lt;path|.sln&gt;` wraps the Roslyn extractor and the Python core (run on system Python) into one dotnet tool install.</Description>
    <Authors>PhysShell</Authors>
    <PackageProjectUrl>https://github.com/PhysShell/Own.NET</PackageProjectUrl>
    <RepositoryUrl>https://github.com/PhysShell/Own.NET</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>roslyn;static-analysis;dispose;memory-leak;wpf;lifetime</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!-- NOTE: no PackageLicenseExpression/PackageLicenseFile — the repository
         has no LICENSE file yet (checked: none at root, none referenced from
         README.md). NuGet will warn (NU5125-class) on pack without one; that
         warning is accurate and must not be silenced by guessing a license.
         This is a real pre-publish blocker for the repo owner to resolve —
         see the release checklist. -->

    <!-- Reproducible/deterministic pack (P-013 release-readiness): stable
         across two builds of the same source, and CI builds additionally
         strip local absolute paths from the PDB (ContinuousIntegrationBuild)
         so a CI-built package doesn't embed this runner's temp path. -->
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\OwnSharp.Extractor\OwnSharp.Extractor.csproj" />
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!-- #262 Stage 3, D6: the Rust core rides in the package.

       Rust is the public DEFAULT from Stage 3, so the binary a user runs has
       to be one they already have. OWEN_RUST_CORE stays exactly what it was:
       a development locator. The packaged payload below is what resolves
       when it is absent (see RustCoreLocator.ResolvePackaged).

       Staged EXPLICITLY, never picked up from the tree. $(OwenRustCoreDir)
       must be passed to the pack, laid out as <platform-key>/own-cli[.exe]:

         dotnet pack ... -p:OwenRustCoreDir=/abs/path/to/staged

       That is the whole point of requiring the property. If this globbed
       rust/target/release instead, whether a package carried a Rust core (and
       WHICH one) would depend on whether someone had run cargo in this
       checkout, and in which profile. A package's contents must not be a
       function of the build machine's history. A plain `dotnet build` with no
       property therefore packs no Rust core at all and behaves exactly as it
       did before Stage 3, which is also what keeps the Stage-1 locator
       controls meaningful: they need an install that carries none.

       The payload is cross-platform on purpose. `tools/&lt;tfw&gt;/any/` holds
       every supported platform's binary and the locator picks by the platform
       it is running on, because Owen.Cli is one RID-agnostic dotnet tool and
       splitting it into per-RID packages would change how users install it.
       The release workflow builds each binary natively on its own runner and
       stages them all before packing; the RustCorePacked target below fails the
       pack if the staging directory it was pointed at is empty, so a release
       cannot quietly ship without the engine it just made the default. -->
  <!-- Carried by the OUTPUT, not by an explicit PackagePath, which is the same
       route the bundled extractor already rides: PackAsTool packs this
       project's full publish closure, so a file placed in the output under
       rust-core/ lands in the package under tools/<tfw>/any/rust-core/.

       Adding Pack="true" with a PackagePath ON TOP of that packs each binary
       TWICE, which is what the first attempt did, measured on the built
       package, not reasoned about. It is worth knowing why, because the
       duplicate path is not symmetrical: NuGet decides whether a PackagePath
       is a file or a folder by whether it looks like it has an extension, so
       `own-cli.exe` behaved differently from `own-cli`, and the extensionless
       Unix binary is the one that had to be right. -->
  <ItemGroup Condition="'$(OwenRustCoreDir)' != ''">
    <OwenRustCoreFiles Include="$(OwenRustCoreDir)/**/own-cli;$(OwenRustCoreDir)/**/own-cli.exe" />
    <None Include="@(OwenRustCoreFiles)"
          CopyToOutputDirectory="PreserveNewest"
          Link="rust-core\%(RecursiveDir)%(Filename)%(Extension)"
          Visible="false" />
  </ItemGroup>

  <Target Name="OwenRustCorePacked" BeforeTargets="GenerateNuspec"
          Condition="'$(OwenRustCoreDir)' != ''">
    <Error Condition="'@(OwenRustCoreFiles)' == ''"
           Text="OwenRustCoreDir was set to '$(OwenRustCoreDir)' but no own-cli binary was found under it. Stage 3 makes Rust the default engine, so a package without one would install an Owen whose default engine is missing. Stage the binaries as &lt;platform-key&gt;/own-cli[.exe] first." />
    <Message Importance="high" Text="Owen.Cli: packing Rust core(s): @(OwenRustCoreFiles->'%(RecursiveDir)%(Filename)%(Extension)', ', ')" />
  </Target>

  <ItemGroup>
    <!-- Vendor the Python core's source as-is (no build step needed — it is
         zero-dependency pure Python, pyproject.toml: requires-python >=3.11).
         Flat file list: ownlang/ has no subdirectories besides __pycache__,
         excluded here since it's interpreter/version-specific and regenerated
         on first run anyway. -->
    <OwnlangCoreFiles Include="..\..\..\ownlang\*.py" />
    <None Include="@(OwnlangCoreFiles)"
          Pack="true"
          PackagePath="tools\$(TargetFramework)\any\ownlang-core\ownlang\%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest"
          Visible="false" />
  </ItemGroup>

</Project>

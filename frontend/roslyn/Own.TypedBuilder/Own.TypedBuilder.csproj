<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>own-typed-builder</AssemblyName>
    <RootNamespace>Own.TypedBuilder</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Syntax only: the generator parses one declaration file, it never builds a
         compilation. Same Roslyn as the extractor, so one restore serves both. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.9.2" />
  </ItemGroup>

</Project>

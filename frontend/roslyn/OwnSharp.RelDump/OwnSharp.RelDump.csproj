<Project Sdk="Microsoft.NET.Sdk">
  <!-- ownership-semantics-lab H-21 (research-only): IL + signature relation dump of one assembly for the CT Gate 0 relation table -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>ownsharp-reldump</AssemblyName>
    <RootNamespace>OwnSharp.RelDump</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.9.2" />
  </ItemGroup>
</Project>

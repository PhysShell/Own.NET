<Project Sdk="Microsoft.NET.Sdk">
  <!-- N1 competitor gate reproductions. No PackageReference: analyzers are referenced by path
       (pass -p:NuGetRoot=<global packages folder>). Built from a copy outside any tree with
       corporate MSBuild settings. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Library</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <Analyzer Include="$(NuGetRoot)/idisposableanalyzers/4.0.8/analyzers/dotnet/cs/IDisposableAnalyzers.dll" />
    <Analyzer Include="$(NuGetRoot)/sonaranalyzer.csharp/10.35.0.4138/analyzers/SonarAnalyzer.CSharp.dll" />
  </ItemGroup>
</Project>

      "description": "the Rust flow walk stops recursing into one nesting shape",
      "target": "rust/crates/own-ir/src/strict.rs",
      "pattern": "        for key in \\[\"then\", \"else\", \"body\"\\] \\{",
      "replacement": "        for key in [\"then\", \"else\"] {",

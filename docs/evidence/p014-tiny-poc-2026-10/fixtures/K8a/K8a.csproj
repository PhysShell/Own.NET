<Project Sdk="Microsoft.NET.Sdk">
  <!-- K3 + K8a: net8.0 with packages newer than the framework copies (package must win by AssemblyVersion). -->
  <PropertyGroup><TargetFramework>net8.0</TargetFramework><ImplicitUsings>disable</ImplicitUsings></PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.Collections.Immutable" Version="9.0.0" />
    <PackageReference Include="System.Reflection.Metadata" Version="9.0.0" />
  </ItemGroup>
</Project>

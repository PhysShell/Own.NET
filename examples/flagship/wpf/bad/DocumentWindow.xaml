<Window x:Class="Owen.Flagship.Wpf.DocumentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Document" Height="240" Width="360"
        ShowInTaskbar="False" WindowStartupLocation="CenterScreen">
    <StackPanel Margin="16">
        <TextBlock x:Name="TitleText" FontSize="18" Text="Untitled document" />
        <TextBlock x:Name="ThemeText" Margin="0,8,0,0" Foreground="Gray" />
    </StackPanel>
</Window>
